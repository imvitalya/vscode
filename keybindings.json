// Place your key bindings in this file to override the defaults
[
  {
    "key": "shift+cmd+g",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active"
  },
  {
    "key": "ctrl+shift+g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active"
  },
  {
    "key": "cmd+n", // "cmd+n" on mac
    "command": "extension.advancedNewFile",
  },
  {
    "key": "ctrl+shift+s",
    "command": "workbench.action.files.saveAs"
  },
  {
    "key": "shift+cmd+s",
    "command": "-workbench.action.files.saveAs"
  },
  {
    "key": "cmd+k s",
    "command": "-workbench.action.files.saveWithoutFormatting"
  },
  {
    "key": "cmd+s",
    "command": "workbench.action.files.save"
  },
  {
    "key": "cmd+s",
    "command": "-workbench.action.files.save"
  },
  {
    "key": "shift+cmd+s",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "shift+cmd+t",
    "command": "-workbench.action.reopenClosedEditor"
  },
  {
    "key": "shift+cmd+y",
    "command": "workbench.view.extension.yandex-music-explorer",
    "when": "viewContainer.workbench.view.extension.yandex-music-explorer.enabled"
  },
  {
    "key": "shift+alt+y shift+alt+m",
    "command": "-workbench.view.extension.yandex-music-explorer",
    "when": "viewContainer.workbench.view.extension.yandex-music-explorer.enabled"
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.toggleLightDarkThemes"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.action.chat.open",
    "when": "!chatSetupHidden"
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.panel.chat",
    "when": "workbench.panel.chat.view.copilot.active"
  },
  {
    // открыть Open Editors в правой панели
    "key": "shift+cmd+t",
    "command": "workbench.files.action.focusOpenEditorsView",
    "when": "!(auxiliaryBarVisible && focusedView == 'workbench.explorer.openEditorsView')"
  },
  {
    // уже на Open Editors — прячем правую панель
    "key": "shift+cmd+t",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "auxiliaryBarVisible && focusedView == 'workbench.explorer.openEditorsView'"
  },
  {
    "key": "alt+cmd+b",
    "command": "-workbench.action.toggleAuxiliaryBar"
  },
  {
    "key": "cmd+k e",
    "command": "-workbench.files.action.focusOpenEditorsView",
    "when": "workbench.explorer.openEditorsView.active"
  },
  {
    // открыть Claude Code в правой панели
    "key": "shift+cmd+a",
    "command": "claude-vscode.sidebar.open",
    "when": "!claude-vscode.sideBarActive"
  },
  {
    // уже на Claude Code — прячем правую панель
    "key": "shift+cmd+a",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "claude-vscode.sideBarActive"
  },
  {
    "key": "ctrl+d",
    "command": "editorScroll",
    "when": "editorTextFocus",
    "args": {
      "to": "down",
      "by": "halfPage"
    }
  },
  {
    "key": "ctrl+u",
    "command": "editorScroll",
    "when": "editorTextFocus",
    "args": {
      "to": "up",
      "by": "halfPage"
    }
  },
  {
    "key": "shift+cmd+i",
    "command": "workbench.view.extension.claude-dev-ActivityBar",
    "when": "viewContainer.workbench.view.extension.claude-dev-ActivityBar.enabled"
  }
]